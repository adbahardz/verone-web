---
// Datos con la posición invertida: Grande a la izquierda, pequeño a la derecha
const featuredProjects = [
  {
    title: "Un Nuevo Paso de Fé",
    subtitle: "Instantes de reflexión, sonrisas y complicidad capturados en un día especial.",
    image: "/images/nadia.jpg", 
    link: "#",
    isLarge: true
  },
  {
    title: "Jubileo de Oro y Tradición",
    subtitle: "Instantes de unión familiar, sonrisas y una celebración llena de significado.",
    tags: [],
    image: "/images/isabella.jpeg", 
    link: "#",
    isLarge: false
  }
];
---

<section class="asymmetric-section">
  <div class="asymmetric-grid">
    {featuredProjects.map((project) => (
      <a href={project.link} class={`project-card ${project.isLarge ? 'card-large' : 'card-small'}`}>
        <div class="image-wrapper">
          <img src={`${import.meta.env.BASE_URL}${project.image}`} alt={project.title} loading="lazy" />
        </div>
        <div class="project-info">
          <h3 class="project-title">{project.title}</h3>
          {project.subtitle && <p class="project-subtitle">{project.subtitle}</p>}
          {project.tags && project.tags.length > 0 && (
            <div class="project-tags">
              {project.tags.map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  /* Sección con el mismo comportamiento de márgenes de tu página */
  .asymmetric-section {
    width: 100%;
    max-width: 1430px;
    margin: 0 auto;
    padding: 2rem; /* Coincide exactamente con los márgenes laterales del .page-wrapper */
    box-sizing: border-box;
    margin-bottom: -1rem;
  }

  /* Grid asimétrico con columna izquierda grande (2fr) y derecha pequeña (1fr) */
  .asymmetric-grid {
    display: grid;
    grid-template-columns: 2fr 1fr; 
    gap: 2.5rem;
    align-items: start;
    width: 100%;
  }

  .card-large {
    grid-column: 1;
  }

  .card-small {
    grid-column: 2;
  }

  .project-card {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: inherit;
    transition: opacity 0.3s ease;
  }

  .project-card:hover {
    opacity: 0.88;
  }

  .image-wrapper {
    width: 100%;
    background-color: #111;
    overflow: hidden;
  }

  .image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .project-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .project-title {
    font-family: "Futura", "Futura PT", "Outfit", sans-serif;
    font-size: 1.05rem;
    font-weight: 500;
    color: #ffffff;
    margin: 0;
    line-height: 1.3;
  }

  .project-subtitle {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 0.9rem;
    color: #a0a0a0;
    font-weight: 300;
    line-height: 1.5;
    margin: 0;
    max-width: 90%;
  }

  .project-tags {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 0.75rem;
    color: #888888;
    background-color: rgba(255, 255, 255, 0.06);
    padding: 0.25rem 0.6rem;
    border-radius: 3px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 868px) {
    .asymmetric-section {
      padding: 1.25rem; /* Coincide con el padding responsivo del .page-wrapper en móviles */
    }

    .asymmetric-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .card-large, .card-small {
      grid-column: auto;
    }

    .project-subtitle {
      max-width: 100%;
    }
  }
</style>