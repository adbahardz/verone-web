---
// Proyectos específicos para la imagen institucional de la Fuerza Aérea
const projects = [
  {
    title: "Revista Oficial FAP",
    year: "Agosto 2016",
    image: "/images/Fap/fap_01.png",
    link: "#",
    objectPosition: "center",
    scale: "1",
    cardWidth: "220px",
    wrapperHeight: "300px"
  },
  {
    title: "Revista Oficial FAP",
    year: "Julio 2018",
    image: "/images/Fap/fap_02.png",
    link: "#",
    objectPosition: "center",
    scale: "1",
    cardWidth: "220px",
    wrapperHeight: "300px"
  },
  {
    title: "Revista Oficial FAP",
    year: "Octubre 2017",
    image: "/images/Fap/fap_03.png",
    link: "#",
    objectPosition: "center",
    scale: "1",
    cardWidth: "220px",
    wrapperHeight: "300px"
  },
  {
    title: "Revista Oficial FAP",
    year: "Mayo 2017",
    image: "/images/Fap/fap_04.png",
    link: "#",
    objectPosition: "center",
    scale: "1",
    cardWidth: "220px",
    wrapperHeight: "300px"
  },
  {
    title: "Revista Oficial FAP",
    year: "Marzo 2016",
    image: "/images/Fap/fap_05.png",
    link: "#",
    objectPosition: "center",
    scale: "1",
    cardWidth: "220px",
    wrapperHeight: "300px"
  },
];
---

<!-- Importación de Plus Jakarta Sans -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400&display=swap" rel="stylesheet">

<section class="process-section">
  <div class="process-header">
    <h2 class="process-title">Fuerza Aérea del Perú</h2>
    <p class="process-description">
      Cobertura documental, institucional y fotográfica conmemorativa. Un homenaje visual a la disciplina, la técnica y la soberanía en cada fotograma con un estándar de producción de alto nivel.
    </p>
  </div>

  <!-- Carrusel Infinito -->
  <div class="carousel-container">
    <div class="carousel-track">
      <!-- Duplicamos el array para lograr el bucle infinito continuo -->
      {[...projects, ...projects].map((item) => (
        <a 
          href={item.link} 
          class={`project-card ${item.customClass || ''}`}
          style={item.cardWidth ? `flex: 0 0 ${item.cardWidth}; width: ${item.cardWidth};` : ''}
        >
          <div 
            class="image-wrapper"
            style={item.wrapperHeight ? `height: ${item.wrapperHeight};` : ''}
          >
            {item.type === 'video' ? (
              <video 
              src={`${import.meta.env.BASE_URL}${item.image}`} 
              autoplay 
              loop 
              muted 
              playsinline 
              style={`object-position: ${item.objectPosition || 'center'}; transform: scale(${item.scale || '1'});`}
              ></video>
            ) : (
              <img 
                src={`${import.meta.env.BASE_URL}${item.image}`} 
                alt={item.title} 
                loading="lazy" 
                style={`object-position: ${item.objectPosition || 'center'}; transform: scale(${item.scale || '1'});`}
              />
            )}
          </div>
          <div class="project-meta">
            <h3 class="project-title">{item.title}</h3>
            <p class="project-category">{item.year || item.category}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .process-section {
    width: 100%;
    margin-top: 5rem;
    margin-bottom: 2rem;
    overflow: hidden;
    background: radial-gradient(circle at center, #111111 0%, #000000 100%);
    padding: 4rem 3rem;
    box-sizing: border-box;
    border-radius: 0;
  }

  .process-header {
    max-width: 680px;
    margin-bottom: 3rem;
  }

  .process-title {
    font-family: "Futura", "Futura PT", "Outfit", sans-serif;
    font-size: 2.4rem;
    font-weight: 500;
    color: #ffffff;
    letter-spacing: -0.03em;
    margin: 0 0 1.2rem 0;
    line-height: 1.1;
  }

  .process-description {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 1.05rem;
    line-height: 1.7;
    color: #a0a0a0;
    font-weight: 300;
    letter-spacing: 0.015em;
    margin: 0;
  }

  .carousel-container {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .carousel-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    animation: marquee 25s linear infinite;
  }

  .project-card {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    flex: 0 0 280px;
    width: 280px;
    transition: opacity 0.3s ease;
  }

  .project-card:hover {
    opacity: 0.85;
  }

  .image-wrapper {
    width: 100%;
    height: 380px;
    overflow: hidden;
    background-color: #111;
  }

  .image-wrapper img,
  .image-wrapper video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .project-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .project-title {
    font-family: "Futura", "Futura PT", "Outfit", sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    color: #ffffff;
    margin: 0;
    line-height: 1.2;
  }

  .project-category {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 0.85rem;
    color: #666666;
    font-weight: 300;
    margin: 0;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 0.75rem));
    }
  }

  @media (min-width: 1726px) {
    .process-section {
      max-width: 1440px;
      margin-left: auto;
      margin-right: auto;
      border-radius: 4px;
    }
  }

  @media (min-width: 720px) {
    .project-card.feature-card {
      flex: 0 0 400px !important;
      width: 450px !important;
    }
  }

  @media (max-width: 768px) {
    .process-section {
      padding: 3rem 1.5rem;
      border-radius: 0;
    }

    .process-title {
      font-size: 1.9rem;
    }

    .process-description {
      font-size: 0.95rem;
    }
  }
</style>