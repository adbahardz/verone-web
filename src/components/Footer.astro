---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-content">
    <p class="copyright">
      ©{currentYear} VERONE STUDIO <span class="separator">•</span> ALL RIGHTS RESERVED.
    </p>
  </div>
</footer>

<style>
  .footer {
    width: 92%;
    padding: 4rem 2rem 3rem 2rem;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 6rem;
  }

  .footer-content {
    width: 100%;
    max-width: 1440px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .copyright {
    font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.8rem;
    color: #777777;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
  }

  .separator {
    margin: 0 0.5rem;
    color: #444444;
  }

  @media (max-width: 768px) {
    .footer {
      padding: 3rem 1.25rem 2rem 1.25rem;
      margin-top: 4rem;
    }
    
    .copyright {
      font-size: 0.75rem;
      letter-spacing: 0.08em;
    }
  }
</style>